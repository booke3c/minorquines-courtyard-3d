# Copy to /etc/ai-camera.env (used by systemd) or ai-camera/.env (manual runs)
# and fill in your key. Lines are KEY=VALUE, no "export".

OPENAI_API_KEY=sk-...

# --- optional overrides (defaults shown) ---
# IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1024x1024            # or 1024x1536 (portrait, closer to the LCD shape)
# IMAGE_QUALITY=medium            # low / medium / high (cost vs. quality)
# INPUT_FIDELITY=high             # uncomment to preserve faces/details better (costs more)
# GENERATE_TIMEOUT_SEC=300
# PROMPTS_FILE=/opt/ai-camera/prompts.json
# GALLERY_DIR=~/ai-camera-gallery
# WHISPLAY_DIR=~/Whisplay
# SHUTDOWN_HOLD_SEC=3
# CAMERA_CMD=rpicam-still -n -t 1500 --width 2304 --height 1296 --autofocus-on-capture -o {output}
